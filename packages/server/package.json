{
  "name": "@researchcove/server",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jobs": {
      "types": "./dist/jobs.d.ts",
      "default": "./dist/jobs.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "bcryptjs": "3.0.2",
    "firebase-admin": "14.5.0",
    "hono": "4.13.14",
    "jose": "5.10.0",
    "nodemailer": "10.1.1",
    "openai": "4.104.0",
    "stripe": "23.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
