# AI for Research on Firebase: local development settings (copy to .env.local at the repo root). In production these live in apphosting.yaml (web + API), functions/.env
# (Cloud Functions) and the Cloud Run services' settings; secrets in Secret Manager.
# Every setting lives here (or in apphosting.yaml / Secret Manager); plans and prices are in code
# (lib/server/lib/plans.ts, lib/server/lib/prices.ts). Change one and restart or redeploy.

# --- Firebase (Project settings › Your apps › Web app) -------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# 1 = use the local emulators (`pnpm emulators`) instead of the real project.
NEXT_PUBLIC_USE_EMULATORS=1
# App Check with reCAPTCHA Enterprise (replaces Cloudflare Turnstile). Empty = off.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# NEXT_PUBLIC_APP_CHECK_DEBUG=1   debug tokens for local testing
# APP_CHECK_ENFORCE=on   refuse public API calls (legacy-login) without a valid App Check token

# Server side (the API in Next.js route handlers, services/collab and Cloud Functions).
FIREBASE_PROJECT_ID=your-project
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# With the emulators (set by `firebase emulators:exec`; set them yourself for `pnpm dev`):
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Against the real project locally: a service account key file instead of the emulator hosts.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# --- Required -----------------------------------------------------------------------------
SUPPORT_EMAIL=
# Encrypts the Zotero and Mendeley tokens people connect (32+ characters). Keep it: changing it
# disconnects them.
SETTINGS_KEY=
# Only for installs moved from the self-hosted version that had no SETTINGS_KEY: the old
# JWT_SECRET, used as a fallback to read tokens saved then. New installs leave it empty.
# JWT_SECRET=
# Shared by the API, services/collab, services/convert and Cloud Functions for internal calls.
INTERNAL_SECRET=
# Footer: who runs this site (optional; applied when the web app is built).
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_PHONE=

# --- Other services (Cloud Run) -------------------------------------------------------------
CONVERT_URL=http://localhost:4100
COLLAB_URL=http://localhost:4200
# Where the browser opens live editing (services/collab).
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4200/collab

# --- Services -----------------------------------------------------------------------------
# AI: openrouter (default, runs deepseek/deepseek-chat) | deepseek | openai | anthropic | ollama
LLM_PROVIDER=
# With OpenRouter: a key from openrouter.ai/keys (sk-or-…).
LLM_API_KEY=
# LLM_MODEL=deepseek/deepseek-chat
# LLM_REVIEW_MODEL=
# LLM_BASE_URL=

# Papers: scholar (default) | openalex
PAPERS_PROVIDER=
SCHOLAR_API_KEY=
OPENALEX_EMAIL=

# Library search: '' = word search only; local = vectors from the converter's POST /embed (a small
# open model on its CPU, no per-token fees) + Firestore vector search; openai = OpenAI's API instead.
EMBEDDINGS_PROVIDER=local
# Where POST /embed runs: the `embed` Cloud Run service in production; empty = CONVERT_URL (fine locally).
EMBED_URL=
# Only for EMBEDDINGS_PROVIDER=openai:
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODEL=text-embedding-3-small

# --- Sign-in ----------------------------------------------------------------------------------
# Providers are set up in Firebase console › Authentication › Sign-in method; these switches
# only choose which buttons this site shows ('on'/'off').
SIGNIN_PASSWORD=on
SIGNIN_GOOGLE=on
SIGNIN_MICROSOFT=on
SIGNIN_APPLE=on

# --- Library imports ----------------------------------------------------------------------
# ZOTERO_CLIENT_KEY=
# ZOTERO_CLIENT_SECRET=
# ZOTERO_CALLBACK_URL=
# MENDELEY_CLIENT_ID=
# MENDELEY_CLIENT_SECRET=

# --- Email (invitations; Firebase sends sign-in emails itself) -------------
# smtp | resend; off when empty
MAIL_PROVIDER=
# MAIL_FROM="AI for Research <hello@example.com>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# RESEND_API_KEY=

# --- Payments -------------------------------------------------------------------------------
# DODO_PAYMENTS_API_KEY=        # Dodo Payments test-mode key (live mode needs BILLING_LIVE=1)
# DODO_PAYMENTS_WEBHOOK_KEY=    # secret of the webhook you add in the Dodo dashboard (https://aiforresearch.app/api/dodo/webhook)
# BILLING_LIVE=

# --- Cloudflare deploy (read by cloudflare.config.ts) --------------------------------------
# ID of the KV namespace used for the vinext cache (Workers › KV in the dashboard).
VINEXT_KV_CACHE_ID=
