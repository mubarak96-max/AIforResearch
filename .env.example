# ResearchCove on Firebase: local development settings (copy to .env.local at the repo root and in
# apps/web). In production these live in apps/web/apphosting.yaml (web + API), functions/.env
# (Cloud Functions) and the Cloud Run services' settings; secrets in Secret Manager.
# Most service settings below can also be changed later in the app: Admin (signed in as an admin).

# --- Firebase (Project settings › Your apps › Web app) -------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=
# 1 = use the local emulators (`pnpm emulators`) instead of the real project.
NEXT_PUBLIC_USE_EMULATORS=1
# App Check with reCAPTCHA Enterprise (replaces Cloudflare Turnstile). Empty = off.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# NEXT_PUBLIC_APP_CHECK_DEBUG=1   debug tokens for local testing

# Server side (the API in Next.js route handlers, services/collab and Cloud Functions).
FIREBASE_PROJECT_ID=your-project
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# With the emulators (set by `firebase emulators:exec`; set them yourself for `pnpm dev`):
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Against the real project locally: a service account key file instead of the emulator hosts.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# --- Required -----------------------------------------------------------------------------
PUBLIC_URL=http://localhost:3000
# Comma-separated emails that become admins once Firebase says their email is confirmed.
ADMIN_EMAILS=
SUPPORT_EMAIL=
# Encrypts keys saved from the admin page (32+ characters). Keep it: changing it loses saved keys.
SETTINGS_KEY=
# Only for installs moved from the self-hosted version that had no SETTINGS_KEY: the old
# JWT_SECRET, used as a fallback to read keys saved in Admin. New installs leave it empty.
# JWT_SECRET=
# Shared by the API, services/collab, services/convert and Cloud Functions for internal calls.
INTERNAL_SECRET=
# Footer: who runs this site (optional; applied when the web app is built).
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_PHONE=

# --- Other services (Cloud Run) -------------------------------------------------------------
CONVERT_URL=http://localhost:4100
COLLAB_URL=http://localhost:4200
# Where the browser opens live editing (services/collab).
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4200/collab

# --- Services -----------------------------------------------------------------------------
# AI: deepseek (default) | openai | anthropic | openrouter | ollama
LLM_PROVIDER=
LLM_API_KEY=
# LLM_MODEL=
# LLM_REVIEW_MODEL=
# LLM_BASE_URL=

# Papers: scholar (default) | openalex
PAPERS_PROVIDER=
SCHOLAR_API_KEY=
OPENALEX_EMAIL=

# Library search: '' = word search; openai = embeddings + Firestore vector search.
EMBEDDINGS_PROVIDER=
EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODEL=text-embedding-3-small

# --- Sign-in ----------------------------------------------------------------------------------
# Providers are set up in Firebase console › Authentication › Sign-in method; these switches
# only choose which buttons this site shows ('on'/'off').
SIGNIN_PASSWORD=on
SIGNIN_GOOGLE=on
SIGNIN_MICROSOFT=on
SIGNIN_APPLE=on

# --- Library imports ----------------------------------------------------------------------
# ZOTERO_CLIENT_KEY=
# ZOTERO_CLIENT_SECRET=
# ZOTERO_CALLBACK_URL=
# MENDELEY_CLIENT_ID=
# MENDELEY_CLIENT_SECRET=

# --- Email (invitations, credit notices; Firebase sends sign-in emails itself) -------------
# smtp | resend; off when empty
MAIL_PROVIDER=
# MAIL_FROM="ResearchCove <hello@example.com>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# RESEND_API_KEY=

# --- Payments -------------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# BILLING_LIVE=

# --- Developer page -----------------------------------------------------------------------
# PUBLIC_API_URL=https://app.example.com
