# Settings for Cloud Functions (copy to functions/.env; secrets go in Secret Manager instead:
# `firebase functions:secrets:set SETTINGS_KEY`). The functions read the same settings as the API.
# Public PostHog project settings used by server-side AI observability.
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host
CONVERT_URL=https://convert-xxxxx.a.run.app
# Library search by meaning: vectors for uploaded PDFs from the converter (match apphosting.yaml).
EMBEDDINGS_PROVIDER=local
EMBED_URL=https://embed-xxxxx.a.run.app
FUNCTIONS_REGION=us-central1
