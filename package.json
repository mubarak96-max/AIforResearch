{
  "name": "researchcove",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@researchcove/web... --filter=@researchcove/collab",
    "dev:all": "firebase emulators:exec --ui --import=.emulator-data --export-on-exit \"pnpm dev\"",
    "emulators": "firebase emulators:start --import=.emulator-data --export-on-exit",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:rules": "firebase emulators:exec --only firestore,storage \"vitest run --root tests/rules\"",
    "deploy:firebase": "firebase deploy --only firestore,storage,functions",
    "migrate": "pnpm --filter @researchcove/migrate start --"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "22.20.5",
    "firebase": "13.2.0",
    "firebase-tools": "15.35.0",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
