{
  "name": "writegrid",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "node scripts/build-blog.mjs && next dev -p 3050",
    "dev:collab": "tsx watch --env-file-if-exists=.env.local services/collab/src/index.ts",
    "dev:all": "firebase emulators:exec --ui --import=.emulator-data --export-on-exit \"node scripts/dev.mjs\"",
    "emulators": "firebase emulators:start --import=.emulator-data --export-on-exit",
    "build": "node scripts/build-blog.mjs && next build",
    "build:collab": "node services/collab/build.mjs",
    "build:functions": "pnpm --dir functions build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit && tsc --noEmit -p services/collab && pnpm --dir functions typecheck",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,storage \"vitest run --root tests/rules\"",
    "install:all": "pnpm install && pnpm --dir functions install && pnpm --dir tools/migrate install",
    "deploy:firebase": "firebase deploy --only firestore,storage,functions",
    "migrate": "pnpm --dir tools/migrate start --",
    "dev:vinext": "node scripts/build-blog.mjs && vite dev --port 3001",
    "build:vinext": "node scripts/build-blog.mjs && vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "deploy:vinext:warm": "vinext-cloudflare deploy --warm-cache",
    "build:blog": "node scripts/build-blog.mjs"
  },
  "dependencies": {
    "@blocknote/core": "0.47.3",
    "@blocknote/mantine": "0.47.3",
    "@blocknote/react": "0.47.3",
    "@citation-js/core": "^0.7.21",
    "@citation-js/plugin-bibtex": "^0.7.21",
    "@citation-js/plugin-csl": "^0.7.21",
    "@hocuspocus/extension-database": "2.15.3",
    "@hocuspocus/provider": "2.15.3",
    "@hocuspocus/server": "2.15.3",
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@noble/hashes": "^2",
    "@tiptap/pm": "^3.22.4",
    "@vinext/cloudflare": "^1.3.3",
    "bcryptjs": "3.0.2",
    "docx": "^9.5.1",
    "firebase": "13.2.0",
    "firebase-admin": "14.5.0",
    "framer-motion": "^12.43.0",
    "hono": "4.13.14",
    "isomorphic-dompurify": "^2.26.0",
    "jose": "5.10.0",
    "katex": "^0.16.25",
    "mammoth": "^1.12.0",
    "next": "15.5.28",
    "nodemailer": "10.1.1",
    "openai": "4.104.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "stripe": "23.0.1",
    "vinext": "^1.4.3",
    "ws": "8.22.0",
    "y-indexeddb": "9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "@firebase/rules-unit-testing": "6.0.0",
    "@node-rs/argon2": "2.2.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "1.0.0-beta.28",
    "esbuild": "0.28.2",
    "firebase-tools": "15.35.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "3.2.7",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "patchedDependencies": {
      "@vinext/cloudflare@1.3.3": "patches/@vinext__cloudflare@1.3.3.patch"
    }
  }
}
